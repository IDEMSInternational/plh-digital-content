#. type=data_list
#. The string @global.parent_app should not be translated.
msgctxt "data_list"
msgid "Welcome to @global.parent_app"
msgstr "Karibu kwenye @global.parent_app"

#. type=data_list
msgctxt "data_list"
msgid "Tap here to start your journey and support your family today."
msgstr "Bonyeza hapa kuanza safari yako na kuisaidia familia yako leo."

#. type=data_list
msgctxt "data_list"
msgid "Improve your family life today"
msgstr "Boresha maisha ya familia yako leo"

#. type=data_list
#. The string @global.parent_app should not be translated.
msgctxt "data_list"
msgid "1 minute with @global.parent_app makes a real difference. Tap to discover more."
msgstr "Dakika 1 kwenye @global.parent_app inasababisha mabadilio ya kweli. Bonyeza kitufe ili kugundua mengi zaidi."

#. type=data_list
#. The string @fields.user_name! should not be translated.
msgctxt "data_list"
msgid "Great work, @fields.user_name!"
msgstr "Kazi nzuri,@fields.user_name!"

#. type=data_list
msgctxt "data_list"
msgid "You finished your first lesson. Keep it up and build on this!"
msgstr "Umekamilisha somo lako la kwanza. Endelea hivi hivi ili ujiimarishe kwenye hili!"

#. type=data_list
msgctxt "data_list"
msgid "You started something great"
msgstr "Umeanzisha kitu kikubwa sana"

#. type=data_list
#. The string @fields.user_name, should not be translated.
msgctxt "data_list"
msgid "@fields.user_name, you've taken the first step. Tap to keep going!"
msgstr "@fields.user_name, umemaliza hatua ya kwanza. Bonyeza kitufe ili uendelee!"

#. type=data_list
msgctxt "data_list"
msgid "Pick up where you left off"
msgstr "Anzia pale ulipoishia"

#. type=data_list
#. The string @fields.user_name, should not be translated.
msgctxt "data_list"
msgid "@fields.user_name, a few more minutes and you'll be done. Tap to continue!"
msgstr "@fields.user_name, Dakika chache tu na utakuwa umemaliza. Bonyeza kitufe ili kuendelea!"

#. type=data_list
msgctxt "data_list"
msgid "Keep the momentum going!"
msgstr "Endelea na kasi hiyo hiyo!"

#. type=data_list
msgctxt "data_list"
msgid "Discover a new way to strengthen your family. Tap to keep learning."
msgstr "Vumbua njia mpya ya kuimarisha familia yako. Bonyeza kitufe ili uendelee kujifunza."

#. type=data_list
msgctxt "data_list"
msgid "You're doing great!"
msgstr "Unafanya vizuri sana!"

#. type=data_list
msgctxt "data_list"
msgid "Every small step makes a difference for your family. Tap to continue."
msgstr "Kila hatua ndogo husababisha mabadiliko fulani kwenye familia yako. Gusa ili uendelee."

