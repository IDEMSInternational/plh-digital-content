#. type=data_list
#. The string @global.parent_app should not be translated.
msgctxt "data_list"
msgid "Welcome to @global.parent_app"
msgstr "Wamkelekile ku @global.parent_app"

#. type=data_list
msgctxt "data_list"
msgid "Tap here to start your journey and support your family today."
msgstr "Cofa apha ukuqala uhambo lwakho kwaye uxhase usapho lwakho namhlanje."

#. type=data_list
msgctxt "data_list"
msgid "Improve your family life today"
msgstr "Phucula ubomi bosapho lwakho namhlanje"

#. type=data_list
#. The string @global.parent_app should not be translated.
msgctxt "data_list"
msgid "1 minute with @global.parent_app makes a real difference. Tap to discover more."
msgstr "Umzuzu o 1 ne @global.parent_app wenza umahluko omkhulu. Cofa ukuze ufunde ngakumbi."

#. type=data_list
#. The string @fields.user_name! should not be translated.
msgctxt "data_list"
msgid "Great work, @fields.user_name!"
msgstr "Usebenzile, @fields.user_name!"

#. type=data_list
msgctxt "data_list"
msgid "You finished your first lesson. Keep it up and build on this!"
msgstr "Usigqibile isifundo sakho sokuqala. Qhubeka kwaye wongeze koku!"

#. type=data_list
msgctxt "data_list"
msgid "You started something great"
msgstr "Uqale into entle kakhulu"

#. type=data_list
#. The string @fields.user_name, should not be translated.
msgctxt "data_list"
msgid "@fields.user_name, you've taken the first step. Tap to keep going!"
msgstr "@fields.user_name, uthathe inyathelo lokuqala. Cofa ukuze uqhubeke!"

#. type=data_list
msgctxt "data_list"
msgid "Pick up where you left off"
msgstr "Qhubeka apho ubuyeke khona"

#. type=data_list
#. The string @fields.user_name, should not be translated.
msgctxt "data_list"
msgid "@fields.user_name, a few more minutes and you'll be done. Tap to continue!"
msgstr "@fields.user_name, imizuzu imbalwa nje uze ugqibe. Cofa ukuze uqhubeke!"

#. type=data_list
msgctxt "data_list"
msgid "Keep the momentum going!"
msgstr "Qhubeka kwesi santya esihle!"

#. type=data_list
msgctxt "data_list"
msgid "Discover a new way to strengthen your family. Tap to keep learning."
msgstr "Fumana indlela entsha yokomeleza usapho lwakho. Cofa ukuze uqhubeke ufunda."

#. type=data_list
msgctxt "data_list"
msgid "You're doing great!"
msgstr "Uqhuba kakuhle!"

#. type=data_list
msgctxt "data_list"
msgid "Every small step makes a difference for your family. Tap to continue."
msgstr "Inyathelo ngalinye elincinci lenza umahluko ku sapho lwakho. Cofa ukuze uqhubeke."

